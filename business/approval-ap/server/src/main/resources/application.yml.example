server:
  # 审批平台约定端口 8085（iam 8081 / mds 8082 / mes 8083 / rms 8084 顺延）
  port: 8085

spring:
  application:
    name: approval-ap
  profiles:
    active: local

  # 持久化（开发/演示：H2 内存库；生产建议独立库，Flowable ACT_/FLW_ 表与业务扩展表分离）
  datasource:
    url: jdbc:h2:mem:approval;DB_CLOSE_DELAY=-1;MODE=MySQL
    username: sa
    password: ""
    driver-class-name: org.h2.Driver
  jpa:
    # 业务扩展表由 Hibernate 自动建表（dev）；Flowable 自带表由引擎自管。生产建议改为 Flyway 管理。
    hibernate:
      ddl-auto: update
    open-in-view: false
  flyway:
    # 本 ap 暂用 ddl-auto: update 管理扩展表，关闭 Flyway 以避免无迁移脚本报错。
    enabled: false

# CIM 平台框架配置键（契约见各 starter *Properties javadoc）
cim:
  # HTTP 响应契约（cim-spring-support；规约见 docs/platform/server/api-convention.md）
  # 本 ap 现有一处正当例外（附件下载），已在代码里标 @RawResponse
  api:
    response:
      verify: true
      strict: true                       # false = 违规只记 ERROR 不阻断启动（仅过渡期）
      include-packages:
        - com.cim
    dispatch:
      enabled: false
      base-path: /api/v1/messages
      base-packages: []

  auth:
    # 认证开关，**默认开启**（与 rms-ap 同口径）：/api/** 与 /sys/notify/stream 未带有效 JWT
    # 一律 401，身份只认令牌；前端启动时据 /api/v1/approval/me 的 authEnabled 自动走 IAM 登录中继。
    # 无 IAM 的本地演示可临时关掉：--cim.auth.enabled=false（接口放行、身份由 userId/tenantId
    # 查询参数表达，顶栏显示「身份切换」）。
    # ⚠️ 前端身份参数在认证态会被 CurrentUserResolver 忽略——保留它们只为兼容滚动发布期的旧后端。
    enabled: true
    jwks-uri: http://localhost:8081/.well-known/jwks.json
    jwks-cache-ttl: 60m
    admission:
      app-code: approval-ap
      # 业务系统接入 SSO 暂不做准入限制（2026-11-12）：不再要求令牌 apps 含本 ap 码。
      # 恢复限制：改回 enabled: true 即可，app-code 已就位，无需改代码。
      enabled: false

  jpa:
    id:
      mode: SNOWFLAKE
      # 机器号/机房号由部署环境下发；合法区间 0-31（各 5 bit）。
      worker-id: ${CIM_WORKER_ID:1}           # 同数据中心内必须唯一
      datacenter-id: ${CIM_DATACENTER_ID:1}   # 机房/数据中心编号

# Flowable 引擎（独立服务，H2 dev 下自动建表）
flowable:
  database-schema-update: true
  history-level: full
  async-executor-activate: false
  # 关闭定时作业线程，避免测试/开发态悬挂
  job-executor-activate: false

# 审批附件（文件本体存磁盘，元数据入库；生产建议换对象存储）
approval:
  attachment:
    dir: ./data/attachments
    max-size-mb: 20
  # 任务超时提醒：待办停留超过 timeout-minutes 后列表标红 + SSE 推送（OverdueScanner）
  task:
    timeout-minutes: 1440      # 默认 24h
    scan-interval: PT5M        # 扫描间隔（@Scheduled 只认 ISO-8601 / 毫秒）
  # 开放 API 安全（G9）：服务间调用 AppKey + HMAC-SHA256 签名（timestamp|method|path|body）+ 防重放窗口
  # + 按 appCode 限流 + IP 白名单。默认关闭；enable 后仅对携带 X-App-Key 的请求生效，JWT 用户态 / dev 放行不受影响。
  api:
    security:
      enabled: false
      app-keys:
        rms-ap: "请替换为强随机密钥"
        mds-ap: "请替换为强随机密钥"
      replay-window-ms: 300000
      ip-whitelist: []
      rate-limit:
        rms-ap: 60
        mds-ap: 60
  # 权限与业务域（G1/G3）dev 态开关：dev-bypass 默认放行既有 E2E；dev-enforce 开启后按 dev-super-admin 白名单 deny 非超管。
  security:
    dev-bypass: true
    dev-enforce: false
    dev-super-admin:
      - admin
