<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.cim</groupId>
    <artifactId>cim-mds-ap-server</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>cim-mds-ap-server</name>
    <description>MDS 主数据 / 设备主数据服务（业务层 ap）</description>

    <properties>
        <java.version>21</java.version>
        <cim.version>0.0.1-SNAPSHOT</cim.version>
    </properties>

    <dependencies>
        <!-- 基础底座能力（详见 docs/platform/server/README.md） -->
        <dependency>
            <groupId>com.cim</groupId>
            <artifactId>cim-spring-support</artifactId>
            <version>${cim.version}</version>
        </dependency>
        <dependency>
            <groupId>com.cim</groupId>
            <artifactId>cim-jpa-starter</artifactId>
            <version>${cim.version}</version>
        </dependency>
        <dependency>
            <groupId>com.cim</groupId>
            <artifactId>cim-auth-starter</artifactId>
            <version>${cim.version}</version>
        </dependency>
        <dependency>
            <groupId>com.cim</groupId>
            <artifactId>cim-cache-starter</artifactId>
            <version>${cim.version}</version>
        </dependency>
        <dependency>
            <groupId>com.cim</groupId>
            <artifactId>cim-i18n-starter</artifactId>
            <version>${cim.version}</version>
        </dependency>
        <dependency>
            <groupId>com.cim</groupId>
            <artifactId>cim-obs-starter</artifactId>
            <version>${cim.version}</version>
        </dependency>
        <dependency>
            <groupId>com.cim</groupId>
            <artifactId>cim-mq-starter</artifactId>
            <version>${cim.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>cim-mds-ap-server</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
