{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@cim/theme": ["../../../platform/web/packages/theme/src/index.ts"],
      "@cim/theme/*": ["../../../platform/web/packages/theme/src/*"],
      "@cim/ui": ["../../../platform/web/packages/ui/src/index.ts"],
      "@cim/ui/*": ["../../../platform/web/packages/ui/src/*"],
      "@cim/data": ["../../../platform/web/packages/data/src/index.ts"],
      "@cim/data/*": ["../../../platform/web/packages/data/src/*"],
      "@cim/shell": ["../../../platform/web/packages/shell/src/index.ts"],
      "@cim/shell/*": ["../../../platform/web/packages/shell/src/*"],
      "antd": ["node_modules/antd"],
      "dayjs": ["node_modules/dayjs"],
      "react-router-dom": ["node_modules/react-router-dom"],
      "react-router-dom/*": ["node_modules/react-router-dom/*"],
      "zustand": ["node_modules/zustand"],
      "zustand/*": ["node_modules/zustand/*"],
      "dayjs/*": ["node_modules/dayjs/*"],
      "antd/*": ["node_modules/antd/*"],
      "react": ["node_modules/@types/react"],
      "react/jsx-runtime": ["node_modules/@types/react/jsx-runtime"],
      "react-dom": ["node_modules/@types/react-dom"],
      "react-dom/*": ["node_modules/@types/react-dom/*"]
    }
  },
  "include": ["src"]
}
