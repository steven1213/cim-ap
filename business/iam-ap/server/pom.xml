<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.cim</groupId>
    <artifactId>cim-iam-ap-server</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>cim-iam-ap-server</name>
    <description>IAM 统一登录与跨业务准入服务（业务层 ap）</description>

    <properties>
        <java.version>21</java.version>
        <cim.version>0.0.1-SNAPSHOT</cim.version>
    </properties>

    <!-- 与 platform 对齐：保留方法参数名，否则 @PathVariable/@RequestParam 运行期 500（ADR-9） -->
    <build>
        <finalName>cim-iam-ap-server</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <!--
                  沙箱 JDK21 + maven-compiler-plugin 环境下，Lombok 经 annotationProcessorPaths
                  放到 -processorpath 后，javac 未通过 SPI(META-INF/services) 自动发现该处理器，
                  导致 @Getter/@Setter/@Slf4j 静默失效（满屏「找不到符号」）。
                  显式用 -processor 指定 Lombok 处理器类名可稳定触发（绕开 SPI 发现失效）。
                  版本钉死 3.13.0 仍保留：避免解析到 3.16.0 时其它注解处理器行为漂移。
                -->
                <version>3.13.0</version>
                <configuration>
                    <parameters>true</parameters>
                    <compilerArgs>
                        <arg>-processor</arg>
                        <arg>lombok.launch.AnnotationProcessorHider$AnnotationProcessor</arg>
                    </compilerArgs>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>1.18.34</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <!-- 基础底座能力（详见 docs/platform/server/README.md） -->
        <dependency>
            <groupId>com.cim</groupId>
            <artifactId>cim-spring-support</artifactId>
            <version>${cim.version}</version>
        </dependency>
        <dependency>
            <groupId>com.cim</groupId>
            <artifactId>cim-jpa-starter</artifactId>
            <version>${cim.version}</version>
        </dependency>
        <dependency>
            <groupId>com.cim</groupId>
            <artifactId>cim-auth-starter</artifactId>
            <version>${cim.version}</version>
        </dependency>

        <!-- 注：cache/mq/obs/i18n 等 starter 按生产需要再引入；本里程碑聚焦「令牌版本 + ap 准入」，
             仅需基础底座（spring-support / jpa / auth），避免引入 Redis/MQ/OTLP 等外部依赖耦合。 -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Lombok（与 platform 对齐，显式声明注解处理器） -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- H2 内存库（开发/演示数据源，与 application.yml 的 org.h2.Driver 对应；
             cim-jpa-starter 不传递 H2，需本 ap 显式声明） -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- JWT 签发（RS256，与 cim-auth-starter 验签库 jjwt 0.12.6 对齐） -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.12.6</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>
    </dependencies>
</project>
