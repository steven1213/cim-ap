<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.cim</groupId>
    <artifactId>cim-iam-ap-server</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>cim-iam-ap-server</name>
    <description>IAM 统一登录与跨业务准入服务（业务层 ap）</description>

    <properties>
        <java.version>21</java.version>
        <cim.version>0.0.1-SNAPSHOT</cim.version>
    </properties>

    <!-- 与 platform 对齐：保留方法参数名，否则 @PathVariable/@RequestParam 运行期 500（ADR-9） -->
    <build>
        <finalName>cim-iam-ap-server</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <!--
                  沙箱 JDK21 + maven-compiler-plugin 环境下，Lombok 经 annotationProcessorPaths
                  放到 -processorpath 后，javac 未通过 SPI(META-INF/services) 自动发现该处理器，
                  导致 @Getter/@Setter/@Slf4j 静默失效（满屏「找不到符号」）。
                  显式用 -processor 指定 Lombok 处理器类名可稳定触发（绕开 SPI 发现失效）。
                  版本钉死 3.13.0 仍保留：避免解析到 3.16.0 时其它注解处理器行为漂移。
                -->
                <version>3.13.0</version>
                <configuration>
                    <parameters>true</parameters>
                    <compilerArgs>
                        <arg>-processor</arg>
                        <arg>lombok.launch.AnnotationProcessorHider$AnnotationProcessor</arg>
                    </compilerArgs>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>1.18.34</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <!-- 基础底座能力（详见 docs/platform/server/README.md） -->
        <dependency>
            <groupId>com.cim</groupId>
            <artifactId>cim-spring-support</artifactId>
            <version>${cim.version}</version>
        </dependency>
        <dependency>
            <groupId>com.cim</groupId>
            <artifactId>cim-jpa-starter</artifactId>
            <version>${cim.version}</version>
        </dependency>
        <dependency>
            <groupId>com.cim</groupId>
            <artifactId>cim-auth-starter</artifactId>
            <version>${cim.version}</version>
        </dependency>

        <!-- 控制台自身的菜单 / 按钮权限 / 角色（= IAM 这个 ap 的**内部权限**，非跨业务准入）。
             复用平台域模块 cim-system（sys_menu 父子树 + sys_permission(module:res:action) + RBAC），
             不另造表；其 DbLocalAuthorityLoader 会顶替 cim-auth-starter 的默认
             ClaimLocalAuthorityLoader，使控制台权限源由「令牌 roles claim」转「本 ap 库内 RBAC」。
             见 docs/business/iam-ap/server/console-menu-perm-i18n.md §0/§4。 -->
        <dependency>
            <groupId>com.cim</groupId>
            <artifactId>cim-system</artifactId>
            <version>${cim.version}</version>
        </dependency>

        <!-- 系统整体多语言（sys_locale + sys_i18n 两表，DB 驱动 + 中文兜底四级链）。
             平台级 starter，所有 ap 复用；见 docs/platform/server/README.md §7。 -->
        <dependency>
            <groupId>com.cim</groupId>
            <artifactId>cim-i18n-starter</artifactId>
            <version>${cim.version}</version>
        </dependency>

        <!-- 注：cache/mq/obs 等 starter 按生产需要再引入；本里程碑聚焦「令牌版本 + ap 准入
             + 控制台菜单/按钮权限/多语言」，故仅引入上述必要底座，避免耦合 Redis/MQ/OTLP。 -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 鉴权「分层契约」测试用：以 @PreAuthorize 的**显式授权集**发起请求，
             验证「类级伞码 ∧ 方法级细码」两闸门语义（而非只对超管/匿名做黑盒断言）。
             版本由 Boot BOM 统一管理（3.3.5 → Spring Security 6.3.x）。 -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Lombok（与 platform 对齐，显式声明注解处理器） -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- H2 内存库（开发/演示数据源，与 application.yml 的 org.h2.Driver 对应；
             cim-jpa-starter 不传递 H2，需本 ap 显式声明） -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- JWT 签发（RS256，与 cim-auth-starter 验签库 jjwt 0.12.6 对齐） -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.12.6</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>
    </dependencies>
</project>
