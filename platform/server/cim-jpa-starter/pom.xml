<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.cim</groupId>
        <artifactId>cim-ap-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>cim-jpa-starter</artifactId>
    <packaging>jar</packaging>
    <name>cim-jpa-starter</name>
    <description>持久化 starter：多库 EMF / 应用层主键 / 审计填充 / 分级历史 / 多租户过滤 / Flyway 多目录</description>

    <dependencies>
        <dependency>
            <groupId>com.cim</groupId>
            <artifactId>cim-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.cim</groupId>
            <artifactId>cim-spring-support</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!-- Flyway 迁移：db/migration/{mysql,oracle,postgresql,dm,h2} 多目录（见 README §3）。
             按实际启用的数据库追加对应 db 模块（版本由 Spring Boot BOM 收敛）：
             flyway-mysql / flyway-database-postgresql / flyway-database-oracle。
             达梦 DM：Spring Boot 3.3.5 用 Flyway 10.x，社区模块 flyway-database-dameng 在该版本可能需
             Teams 许可；若不可用，复用 oracle 目录脚本（DM 与 Oracle 兼容）或经
             cim.jpa.flyway.locations 指向自有脚本即可，无需在 starter 内依赖。 -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>

        <!--
        ============================================================================
         达梦 DM 适配说明（starter 不内置，由业务 app 提供，避免引入非 Maven Central 私包）：
         1) JDBC 驱动（不在中央仓库，需业务 app 本地安装或私仓引入）：
              <dependency>
                <groupId>com.dameng</groupId>
                <artifactId>DmJdbcDriver18</artifactId>
                <version>8.1.x</version>
              </dependency>
            驱动类 dm.jdbc.driver.DmDriver，URL jdbc:dm://host:5236，产品名 "DM DBMS"。
         2) Hibernate 方言（Hibernate 6 无内置 DmDialect，必须显式配置）：
              <dependency>
                <groupId>com.dameng</groupId>
                <artifactId>DmDialect-for-hibernate6.x</artifactId>
                <version>8.1.x</version>
              </dependency>
            并在配置中指定 spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.DmDialect。
         ============================================================================
        -->

        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 集成测试：H2 内存库验证 JPA/历史全链路 -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 集成测试需加载 cim-spring-support 的自动装配（其 web 组件引用 servlet API） -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
