<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.cim</groupId>
        <artifactId>cim-ap-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>cim-i18n-starter</artifactId>
    <packaging>jar</packaging>
    <name>cim-i18n-starter</name>
    <description>国际化 Starter：全量文案入库（sys_locale + sys_i18n）、DB 版 MessageSource、四级兜底（zh-CN 强制）</description>

    <!--
      ============================================================================
      定位（design.md §2.7 / README §7）：本模块是**可插拔横切能力**（starter）。
        · 装配方式：META-INF/spring/...AutoConfiguration.imports
        · 职责：把 i18n 文案从「打包静态资源」改为「数据库驱动 + 热更新」
        · 与 cim-spring-support 的关系：顶替其默认 MessageResolver（DefaultMessageResolver）
          ——接口在 spring-support，实现在此；不引入本 starter 时行为不变（可插拔）。
      ============================================================================
    -->
    <dependencies>
        <dependency>
            <groupId>com.cim</groupId>
            <artifactId>cim-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.cim</groupId>
            <artifactId>cim-spring-support</artifactId>
        </dependency>
        <dependency>
            <groupId>com.cim</groupId>
            <artifactId>cim-jpa-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- 集成测试：H2 内存库真跑 Flyway，验证 DDL 可执行 + 兜底链 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
