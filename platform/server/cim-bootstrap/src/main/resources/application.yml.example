server:
  port: 8080

spring:
  application:
    name: cim-ap
  # ---------------------------------------------------------------------------
  # 持久化（生产配置模板）。开发/演示默认值见 application.yml（H2 内存库）。
  # 引入 cim-jpa-starter + cim-system 后数据源为必需。
  # ---------------------------------------------------------------------------
  datasource:
    # MySQL 示例（PostgreSQL：jdbc:postgresql://host:5432/cim_ap）
    url: jdbc:mysql://localhost:3306/cim_ap?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
    username: cim
    password: ${CIM_DB_PASSWORD}
    driver-class-name: com.mysql.cj.jdbc.Driver
  jpa:
    # 表结构由 Flyway 管（平台基线 + 各域模块自带脚本），Hibernate 只校验
    hibernate:
      ddl-auto: validate
    open-in-view: false
  flyway:
    enabled: true
    # locations 不写则由平台按库类型自动选择（common + {vendor}），域模块再追加自己的目录；
    # 一旦在此显式声明，平台让位、以本值为准（Spring 键优先）。
    # locations: classpath:db/migration/common,classpath:db/migration/mysql

# =============================================================================
# cim-* 框架配置键（完整定义见各 starter 的 *Properties javadoc；
# 认证/准入契约见 docs/platform/server/design.md §8.1）
# =============================================================================
cim:
  # HTTP 响应契约（cim-spring-support；规约见 docs/platform/server/api-convention.md）
  api:
    response:
      # 启动收尾期反射校验：控制器方法返回非 Result 时必须标 @RawResponse，否则启动失败
      verify: true
      strict: true                       # false = 违规只记 ERROR 不阻断启动（仅过渡期）
      include-packages:                  # 只校验本仓控制器；框架 BasicErrorController 不参与
        - com.cim
    # 消息分发入口（受控例外，默认关闭；结构与差异见 api-convention.md §6）
    dispatch:
      enabled: false
      base-path: /api/v1/messages        # 实际入口 = {base-path}/{请求名}
      base-packages: []                  # 留空取应用主类所在包

  # 多租户（cim-spring-support，默认关闭）
  tenant:
    enabled: false
    header-name: X-Tenant-Id
    default-tenant: ""
    allow-super-cross-tenant: false

  # 持久化（cim-jpa-starter）
  jpa:
    id:
      mode: SNOWFLAKE                    # SNOWFLAKE | UUIDV7
      # 机器号/机房号由部署环境下发（容器随机调度时硬编码必然冲突，见 README §3.1）：
      # 优先级 环境变量 > 此处默认值；合法区间 0-31（各 5 bit）。
      worker-id: ${CIM_WORKER_ID:1}           # 同数据中心内必须唯一
      datacenter-id: ${CIM_DATACENTER_ID:1}   # 机房/数据中心编号
    history:
      enabled: true
      write-mode: IN_TRANSACTION  # IN_TRANSACTION | OUTBOX
    naming:
      # 小写蛇形为框架默认（等价 Boot 默认），无开关；换策略用
      # spring.jpa.hibernate.naming.physical-strategy（框架检测到即让位）
      table-prefix: ""
    # 额外数据源（T1.1）：每个逻辑库一套独立 EMF/TxManager/Hikari；不配置则不启用。
    # datasources:
    #   report:
    #     url: jdbc:postgresql://localhost:5432/cim_report
    #     username: cim
    #     password: ${CIM_REPORT_DB_PASSWORD}
    #     driver-class-name: org.postgresql.Driver
    #     packages-to-scan: com.cim.report.entity
    #     ddl-auto: none
    # Flyway 多目录迁移（T1.5）：全部沿用 Spring Boot 键——spring.flyway.enabled / locations /
    # baseline-on-migrate（见上方 spring.flyway），框架只补默认 locations，不另立开关。

  # 认证（cim-auth-starter；对接 IAM JWKS，契约见 design.md §8.1）
  # 只做验证侧：验签 + 版本失效 + 准入 + 业务鉴权 + 数据权限；登录/签发/吊销在 business/iam-ap。
  auth:
    enabled: true
    jwks-uri: http://iam-ap:8081/.well-known/jwks.json   # IAM 公钥地址（按 kid 轮换）
    jwks-cache-ttl: 60m                 # 公钥缓存时长，到期重拉以支持密钥轮换
    authorities-claim: authorities      # 业务权限集所在 claim 键
    admission:
      app-code: ""                      # 本 ap 接入码（mds-ap/mes-ap），校验令牌 apps claim
      enabled: true                     # 准入开关；关闭则跳过（仅本地调试）

  # 系统域（cim-system 域模块）——本 ap 内部权限来源
  system:
    enabled: true
    rbac:
      fallback-to-claims: false         # 未建档即拒绝（生产默认）
      super-authority: SUPER_ADMIN
    menu:
      include-buttons: false

  # 国际化（cim-i18n-starter）
  i18n:
    enabled: true

  # 缓存（cim-cache-starter）
  cache:
    enabled: true

  # 可观测（cim-obs-starter）
  obs:
    enabled: true

management:
  endpoints:
    web:
      exposure:
        include: health,info,readiness,liveness,prometheus,metrics
  endpoint:
    health:
      probes:
        enabled: true
      show-details: when-authorized
  # 指标公共标签 / 链路开关一律用 Spring 标准键（原 cim.obs.metrics.common-tags.*、cim.obs.trace.enabled 已删除）
  metrics:
    tags:
      app: cim-ap
      env: dev
  tracing:
    enabled: false                # 需要 OTel 链路时改 true，并引入对应 otel 依赖
