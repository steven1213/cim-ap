server:
  port: 8080

spring:
  application:
    name: cim-ap
  # 数据源等配置在对应 P 阶段（P1 持久化）补充；当前为 P0 骨架，无需数据库即可启动
  # datasource:
  #   ...

management:
  endpoints:
    web:
      exposure:
        include: health,info,readiness,liveness
  endpoint:
    health:
      probes:
        enabled: true
      show-details: when-authorized
