server:
  port: 8080

spring:
  application:
    name: cim-ap
  # ---------------------------------------------------------------------------
  # 持久化（M1+ 启用）。未配置数据源时，本项目为纯 Web 骨架，可无库启动。
  # 按需引入 cim-jpa-starter 后填以下内容：
  # datasource:
  #   url: jdbc:mysql://localhost:3306/cim_ap?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
  #   username: cim
  #   password: ${CIM_DB_PASSWORD}
  # jpa:
  #   hibernate:
  #     ddl-auto: validate          # 仅校验，不自动改表（结构由 Flyway 管，见 README §3）
  #   open-in-view: false
  # flyway:
  #   enabled: true               # 开启后由 cim.jpa.flyway 按库类型自动选择迁移目录（见下）
  # ---------------------------------------------------------------------------

# =============================================================================
# cim-* 框架配置键（完整定义见各 starter 的 *Properties javadoc；
# 认证/准入契约见 docs/platform/server/design.md §8.1）
# =============================================================================
cim:
  # 多租户（cim-spring-support，默认关闭）
  tenant:
    enabled: false
    header-name: X-Tenant-Id
    default-tenant: ""
    allow-super-cross-tenant: false

  # 持久化（cim-jpa-starter，M1 启用）
  jpa:
    id:
      mode: SNOWFLAKE             # SNOWFLAKE | UUIDV7
      worker-id: 1                # 生产由部署平台下发，保证同数据中心唯一（README §3.1）
      datacenter-id: 1
    history:
      enabled: true
      write-mode: IN_TRANSACTION  # IN_TRANSACTION | OUTBOX
    naming:
      lowercase-snake: true
      table-prefix: ""
    # 额外数据源（T1.1）：每个逻辑库一套独立 EMF/TxManager/Hikari；不配置则不启用。
    # 配置后自动生成 {name}DataSource / {name}EntityManagerFactory / {name}TransactionManager。
    # datasources:
    #   report:                      # 逻辑库名（示例：报表库）
    #     url: jdbc:postgresql://localhost:5432/cim_report
    #     username: cim
    #     password: ${CIM_REPORT_DB_PASSWORD}
    #     driver-class-name: org.postgresql.Driver
    #     dialect: org.hibernate.dialect.PostgreSQLDialect   # 可省略（自动探测）
    #     packages-to-scan: com.cim.report.entity            # 本库实体包（逗号分隔）
    #     ddl-auto: none             # 生产用 none（结构由 Flyway 管）
    #     maximum-pool-size: 10
    # Flyway 多目录迁移（T1.5）：开启后按库类型选 db/migration/common + db/migration/{vendor}
    # （vendor ∈ mysql/oracle/postgresql/h2）；配合上 spring.jpa.hibernate.ddl-auto=validate。
    flyway:
      enabled: false               # 是否由 cim 框架接管迁移位置选择
      # locations: classpath:db/migration/common,classpath:db/migration/mysql  # 显式覆盖
      baseline-on-migrate: false

  # 国际化（cim-i18n-starter，M4 启用）
  i18n:
    enabled: true

  # 缓存（cim-cache-starter，M4 启用）
  cache:
    enabled: true

  # 认证（cim-auth-starter，M3 启用；对接 IAM JWKS，契约见 design.md §8.1）
  auth:
    enabled: true                       # 总开关；关闭则回退匿名操作人（cim-spring-support）
    jwks-uri: http://iam-ap:8081/.well-known/jwks.json   # IAM 公钥地址（按 kid 轮换）
    jwks-cache-minutes: 60              # 公钥缓存时长，到期重拉以支持密钥轮换
    authorities-claim: authorities      # 业务权限集所在 claim 键
    admission:
      app-code: ""                      # 本 ap 接入码（mds-ap/mes-ap），校验令牌 apps claim
      enabled: true                     # 准入开关；关闭则跳过（仅本地调试）

  # 可观测（cim-obs-starter，M4 启用）
  obs:
    enabled: true

management:
  endpoints:
    web:
      exposure:
        include: health,info,readiness,liveness,prometheus,metrics
  endpoint:
    health:
      probes:
        enabled: true
      show-details: when-authorized
