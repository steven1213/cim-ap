{
  "name": "@cim/ui",
  "version": "0.2.0",
  "private": true,
  "description": "CIM 平台通用组件与样式：P0 迁入样式（tokens/base/shell/ui），P1 落地组件（DataTable/FormGrid/Modal/Page 骨架/StatusTag），交互层基于 antd 5，主题由 @cim/theme 的 CSS 变量驱动。纯展示，不依赖 data / i18n。",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./index.css": "./src/index.css",
    "./base.css": "./src/base.css",
    "./shell.css": "./src/shell.css",
    "./ui.css": "./src/ui.css",
    "./components.css": "./src/components.css"
  },
  "files": [
    "src"
  ],
  "dependencies": {
    "@cim/theme": "*"
  },
  "peerDependencies": {
    "antd": "^5.21.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  }
}
